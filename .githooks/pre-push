#!/bin/sh
# Confere a superficie publica antes de deixar o push sair.
#
# Existe porque a regra ja estava escrita em tres lugares - AGENTS.md
# ("nao ha caminho pessoal, referencia corporativa ou credencial"),
# CONTRIBUTING.md ("remova nomes de usuario, empresa, projeto, host...") e a
# definicao de pronto - e nenhum deles conferia nada. Em 20/08/2026 um script
# entrou com tres nomes de maquina reais no cabecalho e a suite passou.
#
# ATIVE UMA VEZ POR CLONE. Hook nao viaja no clone:
#     git config core.hooksPath .githooks
#
# Para pular conscientemente:
#     git push --no-verify
set -e

# A suite exige PowerShell 7: usa [IO.Path]::GetRelativePath, que nao existe no
# .NET Framework do powershell.exe 5.1. Entao 5.1 NAO serve de reserva.
#
# E nao basta achar "pwsh" no PATH. Se o PowerShell veio da Loja (MSIX), o que
# esta no PATH e' um alias de 0 byte que so ativa em sessao interativa - medido
# em 20/08/2026, quando ele funcionou por uma hora e depois passou a devolver
# "O sistema nao pode executar o programa especificado". Por isso a instalacao
# real vem primeiro, e qualquer candidato de 0 byte e' descartado (-s).
shell_exe=""
for candidato in \
    "/c/Program Files/PowerShell/7/pwsh.exe" \
    "/c/Program Files/PowerShell/7-preview/pwsh.exe"
do
    if [ -s "$candidato" ]; then shell_exe="$candidato"; break; fi
done

if [ -z "$shell_exe" ] && command -v pwsh >/dev/null 2>&1; then
    candidato=$(command -v pwsh)
    if [ -s "$candidato" ]; then shell_exe="$candidato"; fi
fi

if [ -z "$shell_exe" ]; then
    echo "pre-push: PowerShell 7 nao encontrado - a suite publica NAO foi executada." >&2
    echo "          Um alias de 0 byte da Loja nao serve, e o 5.1 tambem nao." >&2
    echo "          Instale o pacote oficial, ou use --no-verify assumindo o risco." >&2
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel)

echo "pre-push: conferindo a superficie publica..."
if "$shell_exe" -NoProfile -File "$repo_root/tests/Test-PublicSurface.ps1"; then
    exit 0
fi

echo "" >&2
echo "pre-push: push BLOQUEADO pela conferencia de superficie publica." >&2
echo "          Corrija os itens acima. Se a falha comprovadamente nao se" >&2
echo "          aplica, repita com --no-verify." >&2
exit 1
